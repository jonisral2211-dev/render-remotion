vo", "luz": "#FFD27F", "pausa": 3.2, "cuenta": {"desde": 3, "texto": "¡Levanta la mano!", "y": 0.2}, "transicion": "fade", "imagenes": [{"media": "jobs/ep5v2-buen-samaritano-3min/scene_05p1.jpg"}, {"media": "jobs/ep5v2-buen-samaritano-3min/scene_05p2.jpg"}], "bloque": "foto_25d", "start": 30.702, "end": 38.08, "words": [{"text": "¿Tú", "start": 30.804, "end": 30.894}, {"text": "ayudarías", "start": 30.907, "end": 31.603}, {"text": "a", "start": 31.615, "end": 31.757}, {"text": "alguien", "start": 31.77, "end": 32.105}, {"text": "que", "start": 32.118, "end": 32.208}, {"text": "lo", "start": 32.221, "end": 32.311}, {"text": "necesita?", "start": 32.324, "end": 32.994}, {"text": "¡Levanta", "start": 33.885, "end": 34.349}, {"text": "la", "start": 34.362, "end": 34.478}, {"text": "mano!", "start": 34.491, "end": 34.877}], "sfx": "transicion", "media": null}, {"texto": "Primero pasó un sacerdote. Lo vio, pero tenía mucha prisa y siguió de largo.", "emocion": "tension", "particulas3d": "polvo", "luz": "#FFD27F", "transicion": "slide", "imagenes": [{"media": "jobs/ep5v2-buen-samaritano-3min/scene_06p1.jpg"}, {"media": "jobs/ep5v2-buen-samaritano-3min/scene_06p2.jpg"}], "bloque": "foto_25d", "start": 38.08, "end": 44.393, "words": [{"text": "Primero", "start": 38.182, "end": 38.607}, {"text": "pasó", "start": 38.62, "end": 38.955}, {"text": "un", "start": 38.968, "end": 39.135}, {"text": "sacerdote.", "start": 39.148, "end": 39.883}, {"text": "Lo", "start": 40.773, "end": 40.954}, {"text": "vio,", "start": 40.967, "end": 41.224}, {"text": "pero", "start": 41.559, "end": 41.753}, {"text": "tenía", "start": 41.766, "end": 42.114}, {"text": "mucha", "start": 42.126, "end": 42.449}, {"text": "prisa", "start": 42.461, "end": 42.887}, {"text": "y", "start": 42.9, "end": 42.977}, {"text": "siguió", "start": 42.99, "end": 43.363}, {"text": "de", "start": 43.376, "end": 43.467}, {"text": "largo.", "start": 43.479, "end": 43.892}], "sfx": "construccion", "media": null}, {"texto": "D