{"fps": 30, "width": 1080, "height": 1920, "durationInFrames": 1448, "audio": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/audio.mp3", "music": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/music.mp3", "sfx": {"impacto": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/sfx_impacto.wav", "whoosh": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/sfx_whoosh.wav"}, "tema": {"formato": "9:16", "paleta": {"primaria": "#FFC93C", "secundaria": "#6EC6FF", "fondo": "#FFF6E0", "texto": "#FFFFFF", "acento": "#FF8A80"}, "tipografia": "Montserrat", "particulas": "ninguna", "resaltado_subtitulos": "#00E5FF", "subtitulos": true, "desenfoque_movimiento": false, "vineta": false, "letterbox": 0, "cierre_s": 0.8, "estilo_imagen": "colorful cartoon comic illustration, bold outlines, high contrast saturated colors, playful and friendly, bright cheerful children's storybook illustration, soft rounded friendly shapes, warm golden light, vivid pastel colors, gentle and safe for kids, vertical 9:16 composition, no text, no letters, no watermark", "sufijo_visual": "", "sub_estilo": "B2_3D_INGREDIENTES"}, "escenas": [{"bloque": "escena_3d", "texto": "¡Hola, aventureros! Hoy conocerás a Kiko y a su capa amarilla.", "sfx": null, "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_00_0.jpg", "z": 2000, "ancho": 1.1}], "start": 0.0, "end": 7.016, "words": [{"text": "¡Hola,", "start": 0.114, "end": 0.547}, {"text": "aventureros!", "start": 1.028, "end": 2.133}, {"text": "Hoy", "start": 3.301, "end": 3.478}, {"text": "conocerás", "start": 3.558, "end": 4.295}, {"text": "a", "start": 4.295, "end": 4.375}, {"text": "Kiko", "start": 4.487, "end": 4.824}, {"text": "y", "start": 4.888, "end": 4.936}, {"text": "a", "start": 4.952, "end": 5.016}, {"text": "su", "start": 5.048, "end": 5.208}, {"text": "capa", "start": 5.272, "end": 5.577}, {"text": "amarilla.", "start": 5.577, "end": 6.186}]}, {"bloque": "escena_3d", "texto": "Kiko es un superhéroe, pero su superpoder es ser amable.", "sfx": "whoosh", "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_01_0.jpg", "z": 2000, "ancho": 1.1}], "start": 7.016, "end": 12.216, "words": [{"text": "Kiko", "start": 7.13, "end": 7.467}, {"text": "es", "start": 7.499, "end": 7.643}, {"text": "un", "start": 7.659, "end": 7.771}, {"text": "superhéroe,", "start": 7.819, "end": 8.653}, {"text": "pero", "start": 9.197, "end": 9.438}, {"text": "su", "start": 9.47, "end": 9.646}, {"text": "superpoder", "start": 9.678, "end": 10.447}, {"text": "es", "start": 10.447, "end": 10.592}, {"text": "ser", "start": 10.592, "end": 10.8}, {"text": "amable.", "start": 10.8, "end": 11.377}]}, {"bloque": "escena_3d", "texto": "¡Zas! Vio a una niña triste porque se le cayeron sus libros.", "sfx": null, "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_02_0.jpg", "z": 2000, "ancho": 1.1}], "start": 12.216, "end": 18.654, "words": [{"text": "¡Zas!", "start": 12.323, "end": 12.804}, {"text": "Vio", "start": 14.027, "end": 14.299}, {"text": "a", "start": 14.299, "end": 14.395}, {"text": "una", "start": 14.412, "end": 14.652}, {"text": "niña", "start": 14.716, "end": 15.02}, {"text": "triste", "start": 15.133, "end": 15.549}, {"text": "porque", "start": 15.629, "end": 15.934}, {"text": "se", "start": 15.966, "end": 16.11}, {"text": "le", "start": 16.142, "end": 16.222}, {"text": "cayeron", "start": 16.303, "end": 16.799}, {"text": "sus", "start": 16.847, "end": 17.12}, {"text": "libros.", "start": 17.152, "end": 17.809}]}, {"bloque": "escena_3d", "texto": "Kiko voló rápido y la ayudó a recogerlos, uno por uno.", "sfx": "whoosh", "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_03_0.jpg", "z": 2000, "ancho": 1.1}], "start": 18.654, "end": 23.978, "words": [{"text": "Kiko", "start": 18.768, "end": 19.169}, {"text": "voló", "start": 19.233, "end": 19.521}, {"text": "rápido", "start": 19.553, "end": 20.178}, {"text": "y", "start": 20.21, "end": 20.258}, {"text": "la", "start": 20.307, "end": 20.387}, {"text": "ayudó", "start": 20.387, "end": 20.755}, {"text": "a", "start": 20.755, "end": 20.851}, {"text": "recogerlos,", "start": 20.883, "end": 21.957}, {"text": "uno", "start": 22.326, "end": 22.55}, {"text": "por", "start": 22.646, "end": 22.807}, {"text": "uno.", "start": 22.823, "end": 23.127}]}, {"bloque": "escena_3d", "texto": "La niña sonrió, y su sonrisa iluminó toda la calle.", "sfx": null, "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_04_0.jpg", "z": 2000, "ancho": 1.1}], "start": 23.978, "end": 29.329, "words": [{"text": "La", "start": 24.092, "end": 24.316}, {"text": "niña", "start": 24.381, "end": 24.765}, {"text": "sonrió,", "start": 24.797, "end": 25.599}, {"text": "y", "start": 25.999, "end": 26.079}, {"text": "su", "start": 26.111, "end": 26.288}, {"text": "sonrisa", "start": 26.32, "end": 26.993}, {"text": "iluminó", "start": 27.041, "end": 27.538}, {"text": "toda", "start": 27.65, "end": 27.874}, {"text": "la", "start": 27.906, "end": 28.018}, {"text": "calle.", "start": 28.115, "end": 28.499}]}, {"bloque": "escena_3d", "texto": "¡Bum! Otros niños quisieron ayudar también, ¡y se hizo un equipo!", "sfx": "whoosh", "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_05_0.jpg", "z": 2000, "ancho": 1.1}], "start": 29.329, "end": 36.022, "words": [{"text": "¡Bum!", "start": 29.436, "end": 29.757}, {"text": "Otros", "start": 30.916, "end": 31.348}, {"text": "niños", "start": 31.364, "end": 31.797}, {"text": "quisieron", "start": 31.861, "end": 32.374}, {"text": "ayudar", "start": 32.39, "end": 32.871}, {"text": "también,", "start": 32.967, "end": 33.624}, {"text": "¡y", "start": 33.88, "end": 33.96}, {"text": "se", "start": 33.992, "end": 34.169}, {"text": "hizo", "start": 34.233, "end": 34.441}, {"text": "un", "start": 34.441, "end": 34.553}, {"text": "equipo!", "start": 34.585, "end": 35.13}]}, {"bloque": "escena_3d", "texto": "Juntos descubrieron que la amabilidad es el mejor superpoder.", "sfx": null, "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_06_0.jpg", "z": 2000, "ancho": 1.1}], "start": 36.022, "end": 41.02, "words": [{"text": "Juntos", "start": 36.133, "end": 36.677}, {"text": "descubrieron", "start": 36.726, "end": 37.591}, {"text": "que", "start": 37.607, "end": 37.703}, {"text": "la", "start": 37.751, "end": 37.831}, {"text": "amabilidad", "start": 37.831, "end": 38.536}, {"text": "es", "start": 38.552, "end": 38.713}, {"text": "el", "start": 38.713, "end": 38.841}, {"text": "mejor", "start": 38.889, "end": 39.258}, {"text": "superpoder.", "start": 39.29, "end": 40.235}]}, {"bloque": "escena_3d", "texto": "Sigue la aventura para descubrir la siguiente historia. ¡Nos vemos!", "sfx": "whoosh", "capas": [{"tipo": "fondo", "media": "jobs/test-estilo-03-comic-colorido-ritmo-rapido/capa_07_0.jpg", "z": 2000, "ancho": 1.1}], "start": 41.02, "end": 47.457, "words": [{"text": "Sigue", "start": 41.134, "end": 41.487}, {"text": "la", "start": 41.535, "end": 41.599}, {"text": "aventura", "start": 41.599, "end": 42.176}, {"text": "para", "start": 42.272, "end": 42.528}, {"text": "descubrir", "start": 42.528, "end": 43.137}, {"text": "la", "start": 43.185, "end": 43.298}, {"text": "siguiente", "start": 43.33, "end": 43.842}, {"text": "historia.", "start": 43.874, "end": 44.435}, {"text": "¡Nos", "start": 45.648, "end": 45.904}, {"text": "vemos!", "start": 45.968, "end": 46.593}]}]}