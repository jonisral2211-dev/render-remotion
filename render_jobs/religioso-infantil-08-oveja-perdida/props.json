}, {"text": "dejó", "start": 15.361, "end": 15.697}, {"text": "a", "start": 15.71, "end": 15.77}, {"text": "las", "start": 15.782, "end": 15.962}, {"text": "demás", "start": 15.974, "end": 16.298}, {"text": "a", "start": 16.311, "end": 16.359}, {"text": "salvo", "start": 16.371, "end": 16.779}, {"text": "y", "start": 17.159, "end": 17.243}, {"text": "salió", "start": 17.255, "end": 17.64}, {"text": "a", "start": 17.652, "end": 17.676}, {"text": "buscarla.", "start": 17.688, "end": 18.277}], "sfx": "revelacion"}, {"texto": "Caminó, caminó y llamó: ¡Ovejita! Hasta que escuchó un balido suave.", "emocion": "tension", "media": "jobs/religioso-infantil-08-oveja-perdida/scene_04.jpg", "personajes": ["Pastor"], "encuadre": "over-the-shoulder", "accion": "calling out", "expresion": "hopeful", "imagenes": [{"media": "jobs/religioso-infantil-08-oveja-perdida/scene_04p1.jpg", "personajes": ["Pastor", "Ovejita"], "encuadre": "close-up", "accion": "listening", "expresion": "hopeful"}], "bloque": "foto_25d", "start": 18.818, "end": 24.054, "words": [{"text": "Caminó,", "start": 18.916, "end": 19.397}, {"text": "caminó", "start": 19.697, "end": 20.19}, {"text": "y", "start": 20.202, "end": 20.31}, {"text": "llamó:", "start": 20.322, "end": 20.659}, {"text": "¡Ovejita!", "start": 20.827, "end": 21.404}, {"text": "Hasta", "start": 21.798, "end": 22.062}, {"text": "que", "start": 22.074, "end": 22.159}, {"text": "escuchó", "start": 22.171, "end": 22.591}, {"text": "un", "start": 22.603, "end": 22.724}, {"text": "balido", "start": 22.736, "end": 23.108}, {"text": "suave.", "start": 23.12, "end": 23.541}], "sfx": "construccion"}, {"texto": "¡La encontró! La cargó en sus brazos y todos celebraron.", "emocion": "climax", "media": "jobs/religioso-infantil-08-oveja-perdida/scene_05.jpg", "personajes": ["Pastor", "Ovejita"], "encuadre": "low angle", "accion": "lifting the lamb", "expresion": "overjoyed", "imagenes": [{"media": "jobs/religioso-infantil-08-oveja-perdida/scene_05p1.jpg", "pers