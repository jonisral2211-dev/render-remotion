": 21.903, "end": 22.352}, {"text": "miedo,", "start": 22.368, "end": 22.833}, {"text": "pero", "start": 23.265, "end": 23.49}, {"text": "cerró", "start": 23.506, "end": 23.922}, {"text": "los", "start": 23.938, "end": 24.275}, {"text": "ojos", "start": 24.291, "end": 24.836}, {"text": "y", "start": 24.852, "end": 24.948}, {"text": "oró", "start": 24.964, "end": 25.236}, {"text": "a", "start": 25.252, "end": 25.332}, {"text": "Dios.", "start": 25.348, "end": 25.909}]}, {"bloque": "escena_3d", "texto": "Entonces Dios envió a un ángel de luz, brillante y amable.", "sfx": null, "capas": [{"tipo": "fondo", "media": "jobs/religioso-infantil-03-daniel-leones/capa_04_0.jpg", "z": 2000, "ancho": 1.1}], "start": 28.136, "end": 35.188, "words": [{"text": "Entonces", "start": 28.25, "end": 28.907}, {"text": "Dios", "start": 28.923, "end": 29.276}, {"text": "envió", "start": 29.292, "end": 29.724}, {"text": "a", "start": 29.741, "end": 29.821}, {"text": "un", "start": 29.837, "end": 30.109}, {"text": "ángel", "start": 30.125, "end": 30.622}, {"text": "de", "start": 30.638, "end": 30.75}, {"text": "luz,", "start": 30.766, "end": 31.167}, {"text": "brillante", "start": 31.567, "end": 32.256}, {"text": "y", "start": 32.273, "end": 32.385}, {"text": "amable.", "start": 32.401, "end": 32.946}]}, {"bloque": "escena_3d", "texto": "Los leones se quedaron tranquilos, y se echaron a dormir.", "sfx": "whoosh", "capas": [{"tipo": "fondo", "media": "jobs/religioso-infantil-03-daniel-leones/capa_05_0.jpg", "z": 2000, "ancho": 1.1}], "start": 35.188, "end": 41.616, "words": [{"text": "Los", "start": 35.302, "end": 35.558}, {"text": "leones", "start": 35.575, "end": 36.055}, {"text": "se", "start": 36.071, "end": 36.2}, {"text": "quedaron", "start": 36.216, "end": 36.728}, {"text": "tranquilos,", "start": 36.744, "end": 37.594}, {"text": "y", "start": 37.898, "end": 37.978}, {"text": "se", "start": 37.994, "end": 38.155}, {"text": "echaron", "start": 38.171, "end": 38.684}, {"text": "a", "star